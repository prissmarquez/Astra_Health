# Copia este archivo como ".env" (en esta misma carpeta) y llena los valores.
# ".env" está en .gitignore: tus llaves reales nunca llegan a GitHub.
# Dónde encontrarlas: Supabase → tu proyecto → Project Settings → API Keys / Data API.

# URL del proyecto, p. ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Llave PUBLICABLE (sb_publishable_... o la antigua "anon").
# Puede compartirse con el front-end: sola no da acceso a nada que RLS no permita.
SUPABASE_PUBLISHABLE_KEY=

# Usuario de prueba (créalo en Authentication → Users → Add user).
# Solo lo usa prueba_conexion.py para comprobar RLS con un token real.
PRUEBA_CORREO=
PRUEBA_CONTRASENA=

# NO pongas aquí la llave secreta (sb_secret_... / service_role).
# Este módulo no la necesita: todo pasa con el token del usuario para que RLS se aplique.
