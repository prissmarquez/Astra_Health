# Copy this file as ".env" (in this same folder) and fill in the values.
# ".env" is in .gitignore: your real keys never reach GitHub.
# Where to find them: Supabase -> your project -> Project Settings -> API Keys / Data API.

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# PUBLISHABLE key (sb_publishable_... or the legacy "anon" key).
# It can be shared with the front-end: on its own it grants nothing RLS does not allow.
SUPABASE_PUBLISHABLE_KEY=

# Test user (create it in Authentication -> Users -> Add user).
# Only check_connection.py uses it, to test RLS with a real token.
TEST_EMAIL=
TEST_PASSWORD=

# SECRET key (sb_secret_... / service_role). SERVER ONLY — never send it to the
# browser. The API uses it only to write records the user must not forge, such
# as the ML analysis result (health_analyses); everything else still goes
# through the user's token so RLS applies.
SUPABASE_SECRET_KEY=
