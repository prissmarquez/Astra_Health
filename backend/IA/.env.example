# Copy this file as ".env" (in this same folder) and fill in the values.
# ".env" is in .gitignore: your real key never reaches GitHub.
# On Render, set these same names in the service's "Environment" tab.

# Claude API key: console.anthropic.com -> API Keys.
# Without it the app still works, using the template explanation.
ANTHROPIC_API_KEY=

# Model. Haiku for development; claude-opus-5-5 for higher-quality text.
CLAUDE_MODEL=claude-haiku-5-5

# false = never call Claude (use it to test the fallback).
AI_ENABLED=true

# Seconds to wait for Claude before using the fallback.
AI_TIMEOUT=15

# Language of the explanations: en or es.
EXPLANATION_LANGUAGE=en
