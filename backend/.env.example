# Astra Health — backend environment variables (ONE file for the whole backend).
#
# Local:   copy this file to backend/.env and fill in the values.
#          backend/.env is in .gitignore: real keys never reach GitHub.
# Railway: set these same names in the service's "Variables" tab. If a variable
#          already exists in the environment, the code uses it and does not
#          need (or read over it from) the .env file.
#
# FRONTEND RULE: only SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY may ever appear
# in browser code. Everything marked "SERVER ONLY" must never go to frontend/.

# ---------------------------------------------------------------- Supabase
# Where: Supabase -> your project -> Project Settings -> API Keys / Data API.

# Project URL, e.g. https://abcdefghijkl.supabase.co. Safe for the frontend.
SUPABASE_URL=

# PUBLISHABLE key (sb_publishable_... or legacy "anon"). Safe for the frontend:
# on its own it grants nothing that RLS does not allow. Used for sign-in and
# for every request made with the user's token.
SUPABASE_PUBLISHABLE_KEY=

# SECRET key (sb_secret_... / service_role). SERVER ONLY — never in frontend/.
# Bypasses RLS. The API uses it only for records the user must not forge
# (e.g. health_analyses, crews); create_test_users.py and reset_passwords.py
# also need it.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Claude (AI explainer)
# Claude API key: console.anthropic.com -> API Keys. SERVER ONLY — never in frontend/.
# Without it the app still works, using the template explanation.
ANTHROPIC_API_KEY=

# Optional. Model to use (default: claude-haiku-5-5). claude-opus-5-5 for higher-quality text.
CLAUDE_MODEL=

# Optional. false = always use the template, never call Claude (default: true).
AI_ENABLED=

# Optional. Seconds to wait for Claude before using the fallback (default: 15).
AI_TIMEOUT=

# ---------------------------------------------------------------- Testing only
# Test user (Supabase -> Authentication -> Users -> Add user). Only
# DataBase/check_connection.py uses it, to test RLS with a real token.
# SERVER/LOCAL ONLY — never in frontend/, never in Railway production.
TEST_EMAIL=
TEST_PASSWORD=
